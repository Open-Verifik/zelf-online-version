<div style="color: inherit; font-size: inherit; line-height: inherit">
	<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-spacing: 0 !important; border-collapse: collapse">
		<tbody>
			<!-- Hero Section with Domain Name -->
			<tr>
				<td style="padding: 48px 40px 32px 40px; text-align: center; background: linear-gradient(135deg, #000000 0%, #1f2937 100%)">
					<p
						style="
							margin: 0 0 12px 0;
							font-size: 12px;
							color: #9ca3af;
							font-weight: 600;
							letter-spacing: 1.5px;
							text-transform: uppercase;
						"
					>
						YOUR ZELF DOMAIN
					</p>
					<h1
						style="
							margin: 0 0 20px 0;
							font-size: 48px;
							font-weight: 800;
							color: #ffffff;
							letter-spacing: -0.03em;
							line-height: 1;
							text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
						"
					>
						<%= tagName %>
					</h1>
					<p style="margin: 0 0 16px 0; font-size: 15px; color: #d1d5db; font-weight: 500">
						Expires on <strong style="color: #ffffff"><%= expires %></strong>
					</p>
					<div
						style="
							display: inline-block;
							background: rgba(255, 255, 255, 0.1);
							backdrop-filter: blur(10px);
							border: 1px solid rgba(255, 255, 255, 0.2);
							color: #ffffff;
							padding: 10px 24px;
							border-radius: 24px;
							font-size: 13px;
							font-weight: 700;
							letter-spacing: 0.8px;
						"
					>
						<%= yearLabel %>
					</div>
				</td>
			</tr>

			<!-- Welcome Message -->
			<tr>
				<td style="padding: 40px 40px 32px 40px; text-align: center; background: #000000">
					<p style="margin: 0 0 16px 0; font-size: 16px; color: #9ca3af; font-weight: 500; letter-spacing: 0.3px">
						Welcome to the Zelf Ecosystem
					</p>
					<h2 style="margin: 0 0 20px 0; font-size: 28px; font-weight: 800; color: #ffffff; letter-spacing: -0.01em">
						WHAT IS ZELF NAME SERVICE?
					</h2>
					<p style="margin: 0; font-size: 15px; color: #d1d5db; line-height: 1.7; max-width: 500px; margin-left: auto; margin-right: auto">
						<strong style="color: #ffffff">Zelf Name Service (ZNS)</strong> provides a revolutionary way to store your seed phrase using
						cutting-edge privacy-preserving encryption powered by <strong style="color: #ffffff">Zero Knowledge Face Proofs™</strong>.
						Never lose your crypto assets.
					</p>
				</td>
			</tr>

			<!-- CTA Button -->
			<tr>
				<td style="padding: 0 40px 48px 40px; text-align: center; background: #000000">
					<!--[if mso]>
						<v:roundrect
							xmlns:v="urn:schemas-microsoft-com:vml"
							xmlns:w="urn:schemas-microsoft-com:office:word"
							href="https://zelf.world/download"
							style="height: 52px; v-text-anchor: middle; width: 220px"
							arcsize="23%"
							strokecolor="#FFFFFF"
							fillcolor="#FFFFFF"
						>
							<w:anchorlock />
							<center style="color: #000000; font-family: sans-serif; font-size: 16px; font-weight: bold">Download the App →</center>
						</v:roundrect>
					<![endif]-->
					<!--[if !mso]><!-->
					<a
						href="https://zelf.world/download"
						style="
							display: inline-block;
							background: #ffffff;
							color: #000000;
							text-decoration: none;
							padding: 18px 48px;
							border-radius: 12px;
							font-size: 16px;
							font-weight: 700;
							letter-spacing: 0.3px;
							box-shadow: 0 8px 24px rgba(255, 255, 255, 0.15);
							border: 2px solid #ffffff;
						"
					>
						Download the App →
					</a>
					<!--<![endif]-->
				</td>
			</tr>

			<!-- Lease Agreement Section -->
			<tr>
				<td style="padding: 0 40px 48px 40px; background: #000000">
					<div
						style="
							background: linear-gradient(135deg, #0f0f0f 0%, #1a1a1a 100%);
							border-radius: 20px;
							padding: 40px;
							border: 1px solid rgba(255, 255, 255, 0.1);
							box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
						"
					>
						<h3
							style="margin: 0 0 32px 0; font-size: 24px; font-weight: 800; color: #ffffff; text-align: center; letter-spacing: -0.01em"
						>
							Lease Agreement
						</h3>

						<!-- Receipt Details Table -->
						<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-spacing: 0">
							<tr>
								<td style="padding: 16px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.1)">
									<span style="font-size: 14px; color: #9ca3af; font-weight: 500">Tag Name</span>
								</td>
								<td style="padding: 16px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.1); text-align: right">
									<span style="font-size: 14px; color: #ffffff; font-weight: 700"><%= tagName %></span>
								</td>
							</tr>
							<tr>
								<td style="padding: 16px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.1)">
									<span style="font-size: 14px; color: #9ca3af; font-weight: 500">Transaction date</span>
								</td>
								<td style="padding: 16px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.1); text-align: right">
									<span style="font-size: 14px; color: #ffffff; font-weight: 700"><%= transactionDate %></span>
								</td>
							</tr>
							<tr>
								<td style="padding: 16px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.1)">
									<span style="font-size: 14px; color: #9ca3af; font-weight: 500">Expires on</span>
								</td>
								<td style="padding: 16px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.1); text-align: right">
									<span style="font-size: 14px; color: #ffffff; font-weight: 700"><%= expires %></span>
								</td>
							</tr>
							<tr>
								<td style="padding: 16px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.1)">
									<span style="font-size: 14px; color: #9ca3af; font-weight: 500">Subtotal</span>
								</td>
								<td style="padding: 16px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.1); text-align: right">
									<span style="font-size: 14px; color: #ffffff; font-weight: 700"><%= subtotal %> USD</span>
								</td>
							</tr>
							<tr>
								<td style="padding: 16px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.1)">
									<span style="font-size: 14px; color: #9ca3af; font-weight: 500">Discount</span>
								</td>
								<td style="padding: 16px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.1); text-align: right">
									<span style="font-size: 14px; color: #ffffff; font-weight: 700"><%= discount %> USD</span>
								</td>
							</tr>
							<tr>
								<td style="padding: 20px 0 0 0">
									<span style="font-size: 18px; color: #ffffff; font-weight: 800">Total</span>
								</td>
								<td style="padding: 20px 0 0 0; text-align: right">
									<span style="font-size: 32px; color: #ffffff; font-weight: 800; letter-spacing: -0.02em"><%= total %> USD</span>
								</td>
							</tr>
						</table>
					</div>
				</td>
			</tr>

			<!-- Footer Message -->
			<tr>
				<td style="padding: 0 40px 48px 40px; text-align: center; background: #000000">
					<p style="margin: 0; font-size: 14px; color: #6b7280; line-height: 1.8">
						Thank you for choosing Zelf. Your domain is now secured on the blockchain.<br />
						Questions? Contact us at
						<a href="mailto:support@zelf.world" style="color: #ffffff; text-decoration: none; font-weight: 700">support@zelf.world</a>
					</p>
				</td>
			</tr>
		</tbody>
	</table>
</div>
