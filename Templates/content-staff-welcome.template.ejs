<div style="padding: 20px 40px 40px 40px">
	<p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6; color: #374151"><%= greeting %></p>

	<p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6; color: #374151">Welcome to <strong><%= companyName %></strong>! 🎉</p>

	<p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6; color: #374151">
		Your account has been successfully created with <strong><%= role %></strong> access. You can now log in to the dashboard and start
		collaborating with your team.
	</p>

	<div style="text-align: center; margin: 32px 0">
		<a
			href="<%= dashboardLink %>"
			style="
				display: inline-block;
				padding: 12px 32px;
				background-color: #000000;
				color: #ffffff;
				text-decoration: none;
				border-radius: 8px;
				font-weight: 600;
				font-size: 15px;
				transition: background-color 0.2s;
			"
		>
			Go to Dashboard
		</a>
	</div>

	<div style="background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 12px; padding: 24px; margin: 32px 0">
		<h3 style="margin: 0 0 12px; font-size: 16px; font-weight: 600; color: #111827">
			Your Access Level: <%= role.charAt(0).toUpperCase() + role.slice(1) %>
		</h3>
		<% if (role === 'admin') { %>
		<p style="margin: 0; font-size: 14px; line-height: 1.6; color: #6b7280">
			You have full administrative access to manage all settings including team members.
		</p>
		<% } else if (role === 'write') { %>
		<p style="margin: 0; font-size: 14px; line-height: 1.6; color: #6b7280">You can read and update client data settings.</p>
		<% } else { %>
		<p style="margin: 0; font-size: 14px; line-height: 1.6; color: #6b7280">You have read-only access to client data settings.</p>
		<% } %>
	</div>

	<p style="margin: 24px 0 0; font-size: 14px; line-height: 1.6; color: #6b7280">
		If you have any questions or need assistance, feel free to reach out to your team administrator.
	</p>

	<div style="border-top: 1px solid #e5e7eb; margin-top: 32px; padding-top: 32px">
		<p style="margin: 0; font-size: 14px; line-height: 1.6; color: #9ca3af">
			<%= sincerely %><br />
			The <%= projectName %> Team
		</p>
	</div>
</div>
