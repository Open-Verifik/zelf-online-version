<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= article.title %></title>
    <style>
        /* Reset */
        body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
        table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
        img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
        body { margin: 0; padding: 0; width: 100% !important; }

        /* Dark theme */
        body {
            background-color: #010110;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            color: #e0e0e0;
        }

        .wrapper {
            max-width: 600px;
            margin: 0 auto;
            padding: 0;
        }

        .header {
            background: linear-gradient(135deg, #0a0a1a 0%, #111128 100%);
            padding: 32px 40px;
            text-align: center;
            border-bottom: 1px solid rgba(255, 85, 0, 0.2);
        }

        .header img {
            height: 28px;
            width: auto;
        }

        .cover-section {
            padding: 0;
        }

        .cover-section img {
            width: 100%;
            height: auto;
            display: block;
        }

        .content {
            background: linear-gradient(180deg, #0d0d24 0%, #0a0a1a 100%);
            padding: 40px;
        }

        .article-meta {
            font-size: 13px;
            color: #888;
            margin-bottom: 8px;
            letter-spacing: 0.3px;
        }

        .article-title {
            font-size: 28px;
            font-weight: 700;
            color: #ffffff;
            margin: 0 0 16px 0;
            line-height: 1.3;
        }

        .article-description {
            font-size: 16px;
            color: #b0b0b0;
            line-height: 1.6;
            margin: 0 0 32px 0;
        }

        .cta-button {
            display: inline-block;
            background: linear-gradient(135deg, #FF5500 0%, #FF7700 100%);
            color: #ffffff !important;
            text-decoration: none;
            padding: 14px 32px;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 600;
            letter-spacing: 0.3px;
        }

        .divider {
            border: none;
            border-top: 1px solid rgba(255, 255, 255, 0.06);
            margin: 32px 0;
        }

        .footer {
            background: #050510;
            padding: 32px 40px;
            text-align: center;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .footer p {
            font-size: 12px;
            color: #666;
            margin: 0 0 8px 0;
            line-height: 1.5;
        }

        .footer a {
            color: #FF5500;
            text-decoration: none;
        }

        .footer a:hover {
            text-decoration: underline;
        }

        .social-links {
            margin: 16px 0;
        }

        .social-links a {
            display: inline-block;
            margin: 0 8px;
            color: #888;
            text-decoration: none;
            font-size: 13px;
        }

        @media only screen and (max-width: 600px) {
            .content { padding: 24px 20px !important; }
            .header { padding: 24px 20px !important; }
            .footer { padding: 24px 20px !important; }
            .article-title { font-size: 22px !important; }
        }
    </style>
</head>
<body>
    <div class="wrapper">
        <!-- Header -->
        <div class="header">
            <a href="<%= landingUrl %>">
                <img src="<%= landingUrl %>/logos/zelf-logo.svg" alt="ZELF" />
            </a>
        </div>

        <!-- Cover Image -->
        <% if (article.coverImage) { %>
        <div class="cover-section">
            <a href="<%= articleUrl %>">
                <img src="<%= article.coverImage.startsWith('http') ? article.coverImage : landingUrl + article.coverImage %>" alt="<%= article.title %>" />
            </a>
        </div>
        <% } %>

        <!-- Content -->
        <div class="content">
            <p class="article-meta">
                By <%= article.author || 'ZELF Team' %> &middot; <%= new Date(article.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
            </p>

            <h1 class="article-title"><%= article.title %></h1>

            <p class="article-description"><%= article.description %></p>

            <!-- CTA -->
            <div style="text-align: center; margin: 32px 0;">
                <a href="<%= articleUrl %>" class="cta-button">
                    Read Full Article →
                </a>
            </div>

            <hr class="divider" />

            <p style="font-size: 14px; color: #999; line-height: 1.6; text-align: center;">
                Zelf uses your face to securely encrypt your wallet — <strong style="color: #ccc;">no passwords, no paper, no stress</strong>. Just you.
            </p>

            <div style="text-align: center; margin-top: 20px;">
                <a href="<%= landingUrl %>/download" class="cta-button" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.15); font-size: 13px; padding: 10px 24px;">
                    Download Zelf Free
                </a>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer">
            <div class="social-links">
                <a href="https://x.com/zelfofficial">X (Twitter)</a>
                <a href="https://discord.gg/aZSFmMcmQJ">Discord</a>
                <a href="https://t.me/zelfnameservice">Telegram</a>
                <a href="https://www.youtube.com/@zelfnameservice">YouTube</a>
            </div>

            <p>You received this email because you subscribed to Zelf updates.</p>
            <p>
                <a href="<%= unsubscribeUrl %>">Unsubscribe</a> &middot;
                <a href="<%= landingUrl %>">Visit zelf.world</a>
            </p>
            <p>&copy; <%= new Date().getFullYear() %> Zelf World. All rights reserved.</p>
        </div>
    </div>

    <!-- Open Tracking Pixel -->
    <img src="<%= trackingPixelUrl %>" width="1" height="1" alt="" style="display:none;" />
</body>
</html>
