<div style="padding-left: 10px; padding-right: 10px; padding-bottom: 20px">
	<div
		style="
			min-width: 280px;
			max-width: 600px;
			width: 100%;
			margin-left: auto;
			margin-right: auto;
			border-collapse: collapse;
			border-spacing: 0;
			padding-bottom: 20px;
			padding-top: 20px;
		"
	>
		<div>
			<div style="color: inherit; font-size: inherit; line-height: inherit">
				<table
					role="presentation"
					width="100%"
					cellpadding="0"
					cellspacing="0"
					style="
						border-spacing: 0 !important;
						border-collapse: collapse;
						font-family: Arial, sans-serif;
						font-size: 12px;
						line-height: 135%;
						color: #9ca3af;
						margin-bottom: 0;
						padding: 0;
					"
				>
					<tbody>
						<tr>
							<td
								align="center"
								valign="top"
								style="
									border-collapse: collapse;
									font-family: Arial, sans-serif;
									font-size: 15px;
									color: #6b7280;
									word-break: break-word;
									text-align: center;
									margin-bottom: 0;
									line-height: 135%;
									padding: 10px 20px;
								"
							>
								<% if (address) { %>
								<p
									style="
										font-family: Arial, sans-serif;
										font-size: 12px;
										font-weight: normal;
										text-decoration: none;
										font-style: normal;
										color: #6b7280;
										direction: lrt;
									"
									dir="lrt"
								>
									<%= address %>
								</p>
								<% } %> <% if (unsubscribeUrl && unsubscribeText) { %>
								<p>
									<a
										data-unsubscribe="true"
										href="<% unsubscribeUrl %>"
										style="
											font-family: Helvetica, Arial, sans-serif;
											font-size: 12px;
											color: #4f46e5;
											font-weight: normal;
											text-decoration: underline;
											font-style: normal;
										"
										target="_blank"
										><% unsubscribeText %></a
									>
								</p>
								<% } %>
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>
