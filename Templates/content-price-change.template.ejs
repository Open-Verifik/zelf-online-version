<table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border-spacing: 0 !important; border-collapse: collapse">
	<tbody>
		<tr>
			<td
				style="
					border-collapse: collapse;
					font-family: Arial, sans-serif;
					font-size: 15px;
					color: #23496d;
					word-break: break-word;
					padding: 20px 40px 7px;
				"
			>
				<div
					style="color: inherit; font-size: inherit; line-height: inherit"
				>
					<div
						style="color: inherit; font-size: inherit; line-height: inherit"
					>
						<p style="font-size: 16px; line-height: 175%; font-weight: bold; text-align: left" align="left"><%- greeting %></p>

						<p style="line-height: 175%; text-align: left" align="left">
							<span style="color: #000000"><%= message %></span>
						</p>

						<p style="mso-line-height-rule: exactly; line-height: 175%; text-align: left; padding-left: 24px; margin-top: 8px; margin-bottom: 4px;" align="left">
							<span style="font-size: 16px; color: #000000"></span>
								<span style="font-size: 16px">
                                    <%- feature %>
								</span>
							</span>
						</p>

						<p style="mso-line-height-rule: exactly; line-height: 175%; text-align: left; padding-left: 24px; margin-top: 8px; margin-bottom: 4px;" align="left">
							<span style="font-size: 16px; color: #000000"></span>
								<span style="font-size: 16px">
                                    <%- price %>
								</span>
							</span>
						</p>

						<p style="line-height: 175%; text-align: left" align="left">
							<span style="color: #000000"><%- effective %></span>
						</p>

						<br />

						<p style="line-height: 175%; text-align: left" align="left">
							<span style="color: #000000"><%= sincerely %></span>
						</p>

						<h3 style="line-height: 175%; font-weight: bold; text-align: left" align="left">
							<span style="color: #000000">Verifik</span>
						</h3>

						<table
							role="presentation"
							width="100%"
							cellpadding="0"
							cellspacing="0"
							style="border-spacing: 0 !important; border-collapse: collapse"
						>
							<tbody>
								<tr>
									<td
										align="center"
										valign="top"
										style="
											border-collapse: collapse;

											font-family: Arial, sans-serif;
											color: #23496d;
											word-break: break-word;
											text-align: center;
											padding: 10px 20px;
											font-size: 0px;
										"
									>
										<img
											src="https://22733348.fs1.hubspotusercontent-na1.net/hub/22733348/hubfs/PiedePagina.png?width=1120&amp;upscale=true&amp;name=PiedePagina.png"
											style="
												outline: none;
												text-decoration: none;
												-ms-interpolation-mode: bicubic;
												max-width: 100%;
												font-size: 16px;
											"
											width="600"
											align="middle"
										/>
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>
			</td>
		</tr>
	</tbody>
</table>
